{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vite": false,
  "entry": [
    "zmart_interface/api/index.ts",
    "zmart_interface/framework/fixtures/*/flow.ts",
    "zmart_interface/**/*.test.{js,ts}",
    "zmart_interface/**/*.spec.{js,ts}",
    "tools/*.mjs",
    "vite.config.js"
  ],
  "project": ["zmart_interface/**/*.{js,mjs,ts}", "tools/*.mjs", "!zmart_interface/build/**"],
  "ignore": ["zmart_interface/workflows/*/canvas/engines/zmart-viewer-drawing/**"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true }
}
