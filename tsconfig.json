{
  // The type checker's view of the page. Nothing is emitted: Vite builds the
  // page, and `tsc --noEmit` only checks it. The page is TypeScript
  // throughout, strict; what stays JavaScript is the build's own tooling
  // (`tools/*.mjs`, the configs), which runs in Node and is not the page.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    // A name nobody reads is dead code: in the TypeScript files, the checker says so.
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // A module is named with its own ending, `.ts` included, as Vite reads it.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // `import.meta.glob`, `?raw` and stylesheet imports, as Vite answers them.
    "types": ["vite/client", "node"],
    // Neuroglancer's insides by the names it offers them under, mapped as
    // `vite.config.js` maps them.
    "paths": {
      "neuroglancer/unstable/*": ["./node_modules/neuroglancer/lib/*"],
      // The ZMART viewer's drawing code, by the declarations it writes for it.
      // The build takes the code from the installed viewer (`vite.config.js`);
      // the checker reads this committed copy, which a Python test holds equal
      // to the installed viewer's (`test_the_drawing_comes_from_the_viewer.py`).
      "zmart-viewer/drawing/*": ["./zmart_interface/workflows/target_acquisition/canvas/engines/zmart-viewer-drawing/*"],
      // The page's own addresses, as the dev server serves them: the specs import
      // modules into the browser by these.
      "/zmart_interface/*": ["./zmart_interface/*"]
    }
  },
  "include": ["zmart_interface", "tools"],
  "exclude": ["zmart_interface/build", "node_modules"]
}
