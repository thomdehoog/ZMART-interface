{
  "name": "zmart-interface",
  "private": true,
  "version": "0.1.0-rc.6",
  "type": "module",
  "description": "The ZMART interface's operator page: built to one self-contained page, with neuroglancer's two background programs beside it, and shipped inside the Python package.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node tools/neuroglancer-workers.mjs",
    "dev": "vite",
    "prebuild": "node tools/neuroglancer-workers.mjs",
    "build": "vite build",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "check:types": "tsc --noEmit",
    "check:imports": "depcruise zmart_interface tools --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "check:api": "node tools/the-api-report.mjs --check",
    "test": "tsc --noEmit && vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "22.19.1",
    "dependency-cruiser": "18.6.0",
    "esbuild": "^0.28.1",
    "knip": "6.41.0",
    "patch-package": "8.0.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vivjs/loaders": "0.22.0",
    "neuroglancer": "2.41.2"
  }
}
