{
  "name": "zmart-interface",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "The ZMART interface's operator page: built to one self-contained page, with neuroglancer's two background programs beside it, and shipped inside the Python package.",
  "license": "MIT",
  "scripts": {
    "predev": "node tools/neuroglancer-workers.mjs",
    "dev": "vite",
    "prebuild": "node tools/neuroglancer-workers.mjs",
    "build": "vite build",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "check:types": "tsc --noEmit",
    "check:imports": "depcruise zmart_interface tools --config .dependency-cruiser.cjs",
    "check:unused": "knip",
    "test": "tsc --noEmit && vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "dependency-cruiser": "18.6.0",
    "esbuild": "^0.28.1",
    "knip": "6.41.0",
    "patch-package": "8.0.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.7",
    "@deck.gl/geo-layers": "9.3.7",
    "@deck.gl/layers": "9.3.7",
    "@luma.gl/constants": "9.3.6",
    "@luma.gl/core": "9.3.6",
    "@luma.gl/engine": "9.3.6",
    "@luma.gl/shadertools": "9.3.6",
    "@luma.gl/webgl": "9.3.6",
    "@math.gl/core": "4.1.0",
    "@vivjs/extensions": "0.22.0",
    "@vivjs/layers": "0.22.0",
    "@vivjs/loaders": "0.22.0",
    "@vivjs/views": "0.22.0",
    "neuroglancer": "2.41.2"
  }
}
